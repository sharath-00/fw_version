# ==============================================================================
# BBMP SMART STREET LIGHTS - FIRMWARE VERSION MONITORING & MAIL AUTOMATION
# Template Configuration (.env.example)
# ==============================================================================

# ThingsBoard IoT Platform Configuration
THINGSBOARD_HOST=https://schnelliot.in/
THINGSBOARD_USERNAME=your_username@schnellenergy.com
THINGSBOARD_PASSWORD=your_password
BBMP_CUSTOMER_ID=e2119df0-45c3-11f0-94dc-77130b2f47e9
TARGET_FW_VERSION=SL530.54

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_smtp_user@schnellenergy.com
SMTP_PASSWORD=your_smtp_app_password
SENDER_EMAIL=your_sender_email@schnellenergy.com

# Email Recipients (Comma-separated)
RECIPIENT_EMAILS=user1@example.com,user2@example.com
BCC_EMAILS=bcc_user@example.com

# Email Subject Prefix
EMAIL_SUBJECT_PREFIX=[BBMP Panels - Firmware Version Status Report]
